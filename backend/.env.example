# SQLite file — with a Render persistent disk mounted at /data, use:
# DATABASE_URL="file:/data/prod.db"
DATABASE_URL="file:./dev.db"

JWT_SECRET="replace-with-a-long-random-string"

# Your deployed Vercel frontend URL (no trailing slash), e.g. https://solocrm.vercel.app
FRONTEND_URL="http://localhost:3000"

# Stripe test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Price ID for your "Pro" recurring price, from https://dashboard.stripe.com/test/products
STRIPE_PRO_PRICE_ID="price_..."

NODE_ENV="production"
